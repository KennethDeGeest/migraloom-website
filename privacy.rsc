1:["$","main",null,{"className":"legal-page","children":[["$","nav",null,{"className":"nav-shell","children":[["$","$Ld",null,{"className":"wordmark","href":"/","children":[["$","span",null,{"className":"loom-mark","aria-hidden":"true","children":[["$","i",null,{}],["$","i",null,{}],["$","i",null,{}],["$","i",null,{}]]}],"MigraLoom"]}],["$","$Ld",null,{"className":"nav-cta","href":"/","children":"Back home"}]]}],["$","header",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Privacy"}],["$","h1",null,{"children":"Your journal belongs to you."}],["$","p",null,{"children":"This policy explains what MigraLoom keeps on your device, what limited technical information our services may process, and the choices you have."}],["$","small",null,{"children":"Effective 11 September 2026"}]]}],["$","article",null,{"children":[["$","h2",null,{"children":"The short version"}],["$","p",null,{"children":"Your migraine journal is designed to stay on your iPhone. We do not sell health information, use journal content for advertising, or require an account for the planned launch."}],["$","h2",null,{"children":"Information stored on your device"}],["$","p",null,{"children":"Entries such as migraine timing and intensity, symptoms, possible triggers, medications and relief attempts, notes, daily check-ins, profile context, and generated summaries are stored locally on your device. We do not receive this journal content through MigraLoom’s normal operation."}],["$","h2",null,{"children":"Limited service information"}],["$","p",null,{"children":"We use Google Firebase Analytics for a small set of product events related to the paywall and subscription flow, and Firebase Crashlytics for technical crash diagnostics. This may include an installation or app-instance identifier, app version, device model, operating-system information, timestamps, event names, and crash traces. We deliberately do not attach journal entries, symptoms, medications, triggers, notes, location, or other health content to these events."}],["$","p",null,{"children":"RevenueCat helps synchronize purchases and subscription access. It may process an anonymous app-user identifier, the Firebase app-instance identifier, product identifiers, purchase history, and subscription lifecycle events. Apple processes App Store payments under Apple’s own terms and privacy policy."}],["$","h2",null,{"children":"What we do not do"}],["$","ul",null,{"children":[["$","li",null,{"children":"We do not sell your personal or health information."}],["$","li",null,{"children":"We do not use your journal to target advertising."}],["$","li",null,{"children":"We do not operate a cloud copy of your journal for the planned launch."}],["$","li",null,{"children":"We do not share journal content with clinicians unless you choose to export and share it yourself."}]]}],["$","h2",null,{"children":"Why we process limited service information"}],["$","p",null,{"children":"We process limited analytics and diagnostics to operate, secure, troubleshoot, and improve MigraLoom, and purchase information to provide paid features and comply with financial or legal obligations. Depending on where you live, these purposes may rely on performance of our agreement, our legitimate interests in operating a reliable service, consent where required, or compliance with law."}],["$","h2",null,{"children":"Your choices and rights"}],["$","p",null,{"children":"You can choose what to record and whether to export a visit summary. Deleting the app removes locally stored MigraLoom data from that device, so export anything you wish to keep first. Apple provides controls for purchases and subscriptions. Depending on your location, you may also have rights to request access, correction, deletion, restriction, objection, or portability for personal information we control, and to complain to your local data-protection authority."}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}],"$L16"]}]
e:["$","h2",null,{"children":"Security, retention, and international processing"}]
f:["$","p",null,{"children":"Local data benefits from the security of your iPhone and its passcode. No system is risk-free, so keep your device and operating system up to date. Firebase, RevenueCat, and Apple may process limited service information in countries outside your own under their safeguards. We retain service information only as reasonably needed for the purposes above, provider retention settings, dispute resolution, security, and legal obligations."}]
10:["$","h2",null,{"children":"The website"}]
11:["$","p",null,{"children":"The MigraLoom website does not require an account and does not use advertising trackers. Our hosting provider may process ordinary request information such as IP address, browser information, requested page, and timestamps to deliver and secure the site. If you email us, we process your address and message to respond; please do not include sensitive medical information."}]
12:["$","h2",null,{"children":"Children and changes"}]
13:["$","p",null,{"children":"MigraLoom is not directed to children under 13. We may update this policy as the product develops and will post a revised effective date here."}]
14:["$","h2",null,{"children":"Contact"}]
15:["$","p",null,{"children":["MigraLoom is responsible for the information described in this policy. Questions, rights requests, or privacy concerns can be sent to ",["$","a",null,{"href":"mailto:support@migraloop.com","children":"support@migraloop.com"}],"."]}]
16:["$","footer",null,{"children":[["$","span",null,{"children":"© 2026 MigraLoom"}],["$","div",null,{"className":"footer-links","children":[["$","$Ld",null,{"href":"/privacy","children":"Privacy"}],["$","$Ld",null,{"href":"/terms","children":"Terms"}],["$","$Ld",null,{"href":"/contact","children":"Contact"}]]}]]}]
